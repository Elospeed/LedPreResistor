  object JvScrollText1: TJvScrollText
    Left = 8
    Top = 376
    Width = 297
    Height = 105
    TextAlignment = taLeftJustify
    Items.Strings = (
      '#####################################'
      
        '                                                                ' +
        '           '
      '   Software / Tool'#39's @ SpeedJohn Electronics'
      '   ===================================   '
      
        '                                                                ' +
        '           '
      '   Web  : [Webseite entfernt]'
      '   Mail : [E-Mail entfernt] '
      
        '                                                                ' +
        '          '
      '#####################################'
      ''
      ''
      ''
      ''
      '**************************************'
      'Linzenzbedingung - Freeware  '
      ''
      '**************************************'
      ''
      ''
      'Einleitung'
      '========'
      ''
      
        'Durch das Herunterladen und Installieren der Software stimmen Si' +
        'e diesen Lizenzbedingungen zu.'
      ''
      
        'Diese Software ist Freeware, bleibt jedoch immer Eigentum von Sp' +
        'eedJohn Electronics.'
      ''
      ''
      ''
      'Ben'#252'tzung / Vervielf'#228'ltigung'
      '======================='
      ''
      
        'Sie d'#252'rfen das Programm uneingeschr'#228'nkt f'#252'r private und beruflic' +
        'he Zwecke kostenlos benutzen.'
      ''
      
        'Auch d'#252'rfen Sie das Programm auf einer nicht kostenpflichtigen I' +
        'nternetseite zum Download anbieten.'
      ''
      
        'Ver'#246'ffentlichungen auf einer Buch- oder Magazin-CD oder anderer ' +
        'Ver'#246'ffentlichungsformen  bedarf es einer Anfrage. In dem Fall se' +
        'nden Sie dem Autor oder SpeedJohn eine E-Mail zu.'
      ''
      
        'Verbreitungen / Vervielf'#228'ltigungen jeglicher Art sind erlaubt, s' +
        'ofern diese kostenlos erfolgen.'
      ''
      
        'Die Decompilierung, Disassemblierung oder '#196'nderung der Software ' +
        'oder der Dokumentation ist untersagt. '
      ''
      ''
      ''
      'Haftung'
      '======='
      ''
      
        'Der Autor/SpeedJohn '#252'bernimmt keine Gew'#228'hrleistung oder Haftung ' +
        'f'#252'r etwaige Sch'#228'den, Folgesch'#228'den Datenverluste oder Ausf'#228'lle di' +
        'e durch die Ben'#252'tzung dieser Software enstehen k'#246'nnen.'
      ''
      
        'Ausschlie'#223'lich der Benutzer haftet f'#252'r die Folgen der Benutzung ' +
        'dieser Software. '
      ''
      ''
      ''
      'Copyright'
      '========'
      ''
      
        'Enthaltene Texte und Bilder d'#252'rfen kopiert/weitergegeben, jedoch' +
        ' in ihrem Inhalt nicht ver'#228'ndert werden.  '
      ''
      
        'Auf Anregungen, Fragen wenden Sie sich bitte an den Autor, oder ' +
        'besuchen Sie unsere Homepage.'
      ''
      ''
      ''
      'Zum Schluss'
      '==========='
      ''
      
        'Sollte eine der Bestimmungen dieser Lizenzbestimmungen unwirksam' +
        ' sein, so wird davon die Wirksamkeit der '#252'brigen Bestimmungen ni' +
        'cht ber'#252'hrt.'
      ''
      
        'DIE NUTZUNG ERFOLGT AUSSCHLIE'#223'LICH AUF EIGENES RISIKO. DAS PROGR' +
        'AMM WIRD SO LIZENSIERT "WIE ES IST". '
      ''
      ''
      'SpeedJohn 11.07.2004 '
      ''
      ''
      ''
      ''
      ''
      ''
      '')
    Active = True
    BackgroundColor = clBlack
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWhite
    Font.Height = -11
    Font.Name = 'MS Sans Serif'
    Font.Style = [fsBold]
  end
