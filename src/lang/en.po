#: uMain.pas rsRechenweg
msgid "Rechenweg"
msgstr "Calculation steps"

#: uMain.pas rsStep1
msgid "Spannung am Widerstand: U_R = U_B − U_F = %s − %s = **%s**"
msgstr "Voltage across the resistor: U_R = U_B − U_F = %s − %s = **%s**"

#: uMain.pas rsStep1N
msgid "Spannung am Widerstand: U_R = U_B − n × U_F = %s − %d × %s = **%s**"
msgstr "Voltage across the resistor: U_R = U_B − n × U_F = %s − %d × %s = **%s**"

#: uMain.pas rsKofi
msgid "Kaffee spendieren"
msgstr "Buy me a coffee"

#: uMain.pas rsStep2
msgid "Idealer Widerstand: R = U_R / I = %s / %s A = **%s** → nächster %s-Wert darüber: **%s**"
msgstr "Ideal resistance: R = U_R / I = %s / %s A = **%s** → next %s value up: **%s**"

#: uMain.pas rsStep3
msgid "Tatsächlicher Strom: I = %s / %s = **%s**"
msgstr "Actual current: I = %s / %s = **%s**"

#: uMain.pas rsStep4
msgid "Verlustleistung: P = U_R × I = %s × %s = **%s** → %s zu %s ausgelastet%s → **%s**"
msgstr "Power dissipation: P = U_R × I = %s × %s = **%s** → %s loaded to %s%s → **%s**"

#: uMain.pas rsStep4Over50
msgid " (> 50 %)"
msgstr " (> 50%)"

#: uMain.pas rsStep4None
msgid "Verlustleistung: P = U_R × I = %s × %s = **%s** → mehr als 0,5 W: **Konstantstromquelle oder grössere Bauform**"
msgstr "Power dissipation: P = U_R × I = %s × %s = **%s** → more than 0.5 W: **constant current source or larger rating**"

#: uMain.pas rsStep5
msgid "Erwärmung (Schätzung): ΔT ≈ P × R_t_h = %s × %d °C/W ≈ **+%d °C** (bei %s)"
msgstr "Temperature rise (estimate): ΔT ≈ P × R_t_h = %s × %d °C/W ≈ **+%d °C** (at %s)"

#: uMain.pas rsStatusLoad
msgid "Auslastung %s"
msgstr "Load %s"

#: uMain.pas rsStatusWarn
msgid "%s würde ca. +%d °C warm – %s empfohlen"
msgstr "%s would heat up by about +%d °C – %s recommended"

#: uMain.pas rsStatusOk
