msgstr " (+%d more)"

#: uMain.pas rsBStep555High
msgid "Ausgang High (Laden über R1 + R2): t_H = ln 2 · (R1 + R2) · C = 0,693 × %s × %s = **%s**"
msgstr "Output High (charging via R1 + R2): t_H = ln 2 · (R1 + R2) · C = 0.693 × %s × %s = **%s**"

#: uMain.pas rsBStep555HighD
msgid "Ausgang High (Laden über R1, Diode überbrückt R2): t_H = ln 2 · R1 · C = 0,693 × %s × %s = **%s**"
msgstr "Output High (charging via R1, diode bypasses R2): t_H = ln 2 · R1 · C = 0.693 × %s × %s = **%s**"

#: uMain.pas rsBStep555Low
msgid "Ausgang Low (Entladen über R2): t_L = ln 2 · R2 · C = 0,693 × %s × %s = **%s**"
msgstr "Output Low (discharging via R2): t_L = ln 2 · R2 · C = 0.693 × %s × %s = **%s**"

#: uMain.pas rsBStep555Rev1
msgid "Aus f und C: R1 + 2 · R2 = 1 / (ln 2 · f · C) = 1 / (0,693 × %s × %s) = **%s**"
msgstr "From f and C: R1 + 2 · R2 = 1 / (ln 2 · f · C) = 1 / (0.693 × %s × %s) = **%s**"

#: uMain.pas rsBStep555Rev1D
msgid "Aus f und C: R1 + R2 = 1 / (ln 2 · f · C) = 1 / (0,693 × %s × %s) = **%s**"
msgstr "From f and C: R1 + R2 = 1 / (ln 2 · f · C) = 1 / (0.693 × %s × %s) = **%s**"

#: uMain.pas rsBStep555Rev2
msgid "Aufteilen für %s High: R1 = %s → **%s**, R2 = %s → **%s** (nächste %s-Werte)"
msgstr "Split for %s High: R1 = %s → **%s**, R2 = %s → **%s** (nearest %s values)"

#: uMain.pas rsBStepFreq
msgid "Frequenz: f = 1 / (t_H + t_L) = 1 / %s = **%s** · LED an: **%s**"
msgstr "Frequency: f = 1 / (t_H + t_L) = 1 / %s = **%s** · LED on: **%s**"

#: uMain.pas rsBStepFreqRev
msgid "Mit den Normwerten: t_H = %s, t_L = %s → f = **%s** · LED an: **%s**"
msgstr "With the standard values: t_H = %s, t_L = %s → f = **%s** · LED on: **%s**"

#: uMain.pas rsBStepOut
msgid "Ausgang High: U_O_U_T ≈ U_B − 1,7 V = %s − 1,7 V = **%s** (Spannungsabfall im NE555)"
msgstr "Output High: U_O_U_T ≈ U_B − 1.7 V = %s − 1.7 V = **%s** (voltage drop in the NE555)"

#: uMain.pas rsBStepOutVcc
msgid "LED nach +U_B: sie leuchtet, wenn der Ausgang Low ist (≈ 0,1 V); an LED und R bleiben %s − 0,1 V"
msgstr "LED to +U_B: it lights when the output is Low (≈ 0.1 V); LED and R get %s − 0.1 V"

#: uMain.pas rsBStepRv
msgid "Vorwiderstand: R = (%s − %s) / %s = %s → nächster %s-Wert darüber: **%s** → I = **%s**"
msgstr "Series resistor: R = (%s − %s) / %s = %s → next %s value above: **%s** → I = **%s**"

#: uMain.pas rsBStepRvBoth
msgid "Vorwiderstände: LED 1 (nach Masse) **%s**, LED 2 (nach +U_B, Ausgang Low ≈ 0,1 V) **%s** → I = **%s** / **%s**"
msgstr "Series resistors: LED 1 (to ground) **%s**, LED 2 (to +U_B, output Low ≈ 0.1 V) **%s** → I = **%s** / **%s**"

#: uMain.pas rsBStepMultiK
msgid "Sprung am Kollektor: ΔU = U_B − U_F − 0,2 V = **%s** → k = ln((U_B − 0,6 V + ΔU) / (U_B − 0,6 V)) = **%s**"
msgstr "Collector step: ΔU = U_B − U_F − 0.2 V = **%s** → k = ln((U_B − 0.6 V + ΔU) / (U_B − 0.6 V)) = **%s**"


#: uMain.pas rsBStepMultiT
msgid "LED 1 an (T2 gesperrt): t_1 = k · R_B_2 · C = %s × %s × %s = **%s** · LED 2 an: t_2 = k · R_B_1 · C = **%s**"
msgstr "LED 1 on (T2 off): t_1 = k · R_B_2 · C = %s × %s × %s = **%s** · LED 2 on: t_2 = k · R_B_1 · C = **%s**"

#: uMain.pas rsBStepMultiRev
msgid "Aus t_1 = %s (LED 1) und t_2 = %s (LED 2): R_B_2 = t_1 / (k · C) = %s → **%s**, R_B_1 = t_2 / (k · C) = %s → **%s** (nächste %s-Werte)"
msgstr "From t_1 = %s (LED 1) and t_2 = %s (LED 2): R_B_2 = t_1 / (k · C) = %s → **%s**, R_B_1 = t_2 / (k · C) = %s → **%s** (nearest %s values)"

#: uMain.pas rsBStepMultiF
msgid "Frequenz: f = 1 / (t_1 + t_2) = 1 / %s = **%s** · LED 1 an: **%s**"
msgstr "Frequency: f = 1 / (t_1 + t_2) = 1 / %s = **%s** · LED 1 on: **%s**"

