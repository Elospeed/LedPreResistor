msgid "LED nach +U_B: sie leuchtet, wenn der Ausgang Low ist (≈ 0,1 V); an LED und R bleiben %s − 0,1 V"
msgstr "LED to +U_B: it lights when the output is Low (≈ 0.1 V); LED and R get %s − 0.1 V"

#: uMain.pas rsBStepRv
msgid "Vorwiderstand: R = (%s − %s) / %s = %s → nächster %s-Wert darüber: **%s** → I = **%s**"
msgstr "Series resistor: R = (%s − %s) / %s = %s → next %s value above: **%s** → I = **%s**"

#: uMain.pas rsBStepRvBoth
msgid "Vorwiderstände: LED 1 (nach Masse) **%s**, LED 2 (nach +U_B) **%s** → I = **%s** / **%s**"
msgstr "Series resistors: LED 1 (to ground) **%s**, LED 2 (to +U_B) **%s** → I = **%s** / **%s**"

#: uMain.pas rsBStepMultiK
